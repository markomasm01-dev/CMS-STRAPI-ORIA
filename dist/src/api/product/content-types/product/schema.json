{
    "kind": "collectionType",
    "collectionName": "products",
    "info": {
        "singularName": "product",
        "pluralName": "products",
        "displayName": "Product"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "unique": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "short_description": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "description": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "brand": {
            "type": "string"
        },
        "condition": {
            "type": "enumeration",
            "enum": [
                "New",
                "Used",
                "Refurbished"
            ]
        },
        "availability": {
            "type": "enumeration",
            "enum": [
                "InStock",
                "OutOfStock",
                "PreOrder"
            ]
        },
        "is_featured": {
            "type": "boolean",
            "default": false
        },
        "regular_price": {
            "type": "integer"
        },
        "sale_price": {
            "type": "integer"
        },
        "price_label": {
            "type": "string",
            "default": "Hubungi Kami",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "main_image": {
            "type": "media",
            "multiple": false,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "gallery_images": {
            "type": "media",
            "multiple": true,
            "allowedTypes": [
                "images",
                "files",
                "videos",
                "audios"
            ]
        },
        "whatsapp_message": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "seo_title": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "seo_description": {
            "type": "text",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "canonical_url": {
            "type": "string"
        },
        "category": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::product-category.product-category",
            "inversedBy": "products"
        },
        "sku": {
            "type": "string"
        },
        "mpn": {
            "type": "string"
        },
        "rating_value": {
            "type": "decimal"
        },
        "review_count": {
            "type": "integer"
        },
        "seo_keywords": {
            "type": "string",
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        }
    }
}
