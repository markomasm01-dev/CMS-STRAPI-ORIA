# Server
HOST=0.0.0.0
PORT=1337

# Secrets (Generate using openssl rand -base64 32)
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Client: 'sqlite' for local development or 'mysql' for Hostdata/DirectAdmin production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Database MySQL (DirectAdmin / Hostdata)
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=oria_strapi
# DATABASE_USERNAME=oria_strapi_user
# DATABASE_PASSWORD=your_secure_password
# DATABASE_SSL=false

# Redis Caching (Dual Mode: Unix Socket or Host/Port)
# Mode 1: Hostdata.id DirectAdmin Production via Unix Socket (Faster)
# REDIS_SOCKET_PATH=/home/username/.redis/redis.sock
# REDIS_PASSWORD=

# Mode 2: Local Development or Cloud (Upstash) via Host & Port
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_TLS=false
